{
  "name": "syllable-counter",
  "version": "1.0.0",
  "private": true,
  "description": "音节数计算小工具（多语言，日语先行）",
  "author": "mini-tool",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "vite build && npx @electron/packager . \"音节计数器\" --platform=win32 --arch=x64 --out=release --overwrite --asar",
    "test": "node test/counter.test.js && node test/lyrics.test.js"
  },
  "dependencies": {
    "vue": "^3.4.29"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.minitool.syllablecounter",
    "productName": "音节计数器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "音节计数器-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "音节计数器-${version}-portable.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
